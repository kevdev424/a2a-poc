{
  "name": "kin-agent-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "agent": "tsx apps/agent/src/main.ts",
    "agent:example": "tsx examples/participant.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build --workspace @kin/web",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.1",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "luxon": "^3.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
